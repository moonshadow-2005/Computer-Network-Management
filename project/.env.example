# python run.py automatically reads a local .env (existing shell variables win).
# Demo mode always disables live actions and uses data/demo.sqlite3.
NMS_DB=data/nms.sqlite3
NMS_ENABLE_LIVE=0
NMS_POLL_INTERVAL=0
NMS_SNMP_COMMUNITY=
NMS_API_TOKEN=
NMS_ENABLE_SERVICE_PROBE=0
NMS_ENABLE_IPERF3=0
NMS_IPERF_SSH_USER=test-user
NMS_IPERF_SSH_KEY=
