[Unit]
Description=Group 2 Computer Network Management System
After=network.target

[Service]
Type=simple
User=nms-team2
Group=nms-team2
WorkingDirectory=/opt/nms-team2
EnvironmentFile=/etc/nms-team2/nms.env
Environment=PYTHONPATH=/opt/nms-team2/vendor:/opt/nms-team2
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -m uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1 --no-access-log
Restart=on-failure
RestartSec=3
UMask=0077
StateDirectory=nms-team2
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/nms-team2
LockPersonality=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
