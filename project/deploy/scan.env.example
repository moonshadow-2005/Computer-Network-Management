# Explicit local destinations only. Run `ip -j address show` before configuring.
NMS_DB=/var/lib/nms-team2/nms.sqlite3
NMS_SCAN_SENSOR_ID=dev-inbound
NMS_SCAN_DEVICE_ID=dev
NMS_SCAN_TARGETS=192.168.0.100,240a:a019::100
# Leave empty to classify non-loopback sources as unknown until scope is defined.
# "external" means outside these prefixes, NOT a verified Internet attacker.
NMS_SCAN_INTERNAL_CIDRS=
# Empty captures all host interfaces, still restricted to NMS_SCAN_TARGETS.
NMS_SCAN_INTERFACE=
NMS_SCAN_FAST_PORTS=8
NMS_SCAN_SLOW_PORTS=20
